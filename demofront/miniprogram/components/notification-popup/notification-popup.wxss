.popup-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-container {
  width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  overflow-y: auto;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  animation: popupSlideIn 0.3s ease-out;
}
@keyframes popupSlideIn {
  from { transform: translateY(100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.popup-content {
  padding: 40rpx 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.popup-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.approved-icon-wrap { background: #e8f5e9; }
.rejected-icon-wrap { background: #ffebee; }
.greeting-icon-wrap { background: #e3f2fd; }
.announcement-icon-wrap { background: #fff3e0; }

.popup-icon { font-size: 64rpx; }

.popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.popup-body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
  word-break: break-all;
}

/* 接待建议详情 */
.greeting-detail {
  width: 100%;
  margin-top: 24rpx;
}
.greeting-section {
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.greeting-section-title {
  font-size: 24rpx;
  color: #1a7cee;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}
.greeting-section-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: block;
}

/* 操作按钮 */
.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 36rpx 40rpx;
  justify-content: center;
}
.popup-btn {
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  border: none;
  min-width: 180rpx;
}
.popup-btn-primary {
  background: #1a7cee;
  color: #fff;
}
.popup-btn-secondary {
  background: #f0f6ff;
  color: #1a7cee;
  border: 2rpx solid #1a7cee;
}
