/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  margin: 0 24rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 27rpx;
  color: #888;
  position: relative;
}
.tab.active {
  color: #1a7cee;
  font-weight: 600;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background: #1a7cee;
  border-radius: 3rpx;
}

/* 预约卡片 */
.card {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx;
}
.header-left {
  flex: 1;
  min-width: 0;
}
.visitor-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}
.company-name {
  font-size: 26rpx;
  color: #888;
}
.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-tag.pending  { background: #fff7e6; color: #fa8c16; }
.status-tag.approved { background: #f0fdf4; color: #52c41a; }
.status-tag.rejected { background: #fdf2f2; color: #e74c3c; }
.status-tag.cancelled{ background: #f5f6fa; color: #999; }
.status-tag.confirmed{ background: #eef6ff; color: #1a7cee; }

.expand-arrow {
  font-size: 20rpx;
  color: #ccc;
}

/* 展开详情 */
.card-detail {
  padding: 0 24rpx 22rpx;
  border-top: 2rpx solid #f5f6f8;
  margin-top: -4rpx;
  padding-top: 18rpx;
}
.detail-row {
  display: flex;
  padding: 8rpx 0;
  font-size: 26rpx;
}
.detail-label {
  color: #999;
  width: 140rpx;
  flex-shrink: 0;
}
.detail-value {
  color: #444;
  flex: 1;
}
.detail-value.purpose {
  color: #1a7cee;
  font-weight: 500;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 18rpx 24rpx;
  border-top: 2rpx solid #f5f6f8;
}
.btn-approve, .btn-reject {
  border: none;
  font-size: 26rpx;
  padding: 14rpx 44rpx;
  border-radius: 40rpx;
  font-weight: 500;
}
.btn-approve {
  background: linear-gradient(135deg, #52c41a, #73d13d);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(82,196,26,0.3);
}
.btn-reject {
  background: #f5f6fa;
  color: #e74c3c;
  border: 2rpx solid #fde2e2;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #bbb;
  font-size: 28rpx;
}

/* 快捷入口 */
.quick-links {
  margin: 20rpx 24rpx 40rpx;
  display: flex;
  gap: 16rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 20rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.quick-icon { font-size: 32rpx; margin-right: 12rpx; }
.quick-text { font-size: 26rpx; color: #555; flex: 1; }
.quick-arrow { font-size: 28rpx; color: #ccc; }
