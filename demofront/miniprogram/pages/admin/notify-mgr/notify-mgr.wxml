<view class="page has-tabbar">
  <view class="top-tabs">
    <view class="top-tab {{currentTab==='manage'?'active':''}}" bindtap="switchMyTab" data-tab="manage">公告管理</view>
    <view class="top-tab {{currentTab==='inbox'?'active':''}}" bindtap="switchMyTab" data-tab="inbox">我的通知<text class="inbox-badge" wx:if="{{unreadCount>0}}">{{unreadCount>99?'99+':unreadCount}}</text></view>
  </view>

  <view wx:if="{{currentTab==='manage'}}">
    <view class="card">
      <view class="flex-header"><text class="section-title">通知公告</text><button class="add-btn" bindtap="onAdd">+ 发布</button></view>
      <block wx:for="{{list}}" wx:key="id">
        <view class="notify-item">
          <view class="notify-info" bindtap="onDetail" data-id="{{item.id}}"><text class="notify-title">{{item.title}}</text><text class="notify-time">{{item.createTime}}</text></view>
          <view class="notify-actions"><text class="action-btn" bindtap="onEdit" data-item="{{item}}">编辑</text><text class="action-btn" bindtap="onViewRecipients" data-id="{{item.id}}">查看</text><text class="action-btn action-del" bindtap="onDelete" data-id="{{item.id}}">删除</text></view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{currentTab==='inbox'}}">
    <view class="inbox-tabs">
      <view class="inbox-tab {{inboxFilter==='unread'?'active':''}}" bindtap="filterInbox" data-filter="unread">未读</view>
      <view class="inbox-tab {{inboxFilter==='read'?'active':''}}" bindtap="filterInbox" data-filter="read">已读</view>
      <view class="inbox-tab {{inboxFilter==='all'?'active':''}}" bindtap="filterInbox" data-filter="all">全部</view>
      <text class="mark-all-btn" bindtap="onMarkAllRead" wx:if="{{unreadCount>0}}">全部已读</text>
    </view>
    <block wx:for="{{myListDisplay}}" wx:key="id">
      <view class="inbox-card {{item.isRead?'':'unread'}}" bindtap="onTapInboxItem" data-id="{{item.id}}">
        <view class="inbox-header"><text class="inbox-type-icon">{{inboxTypeIcon[item.type]||'📢'}}</text><text class="inbox-title">{{item.title}}</text><view class="unread-dot" wx:if="{{!item.isRead}}"></view><text class="inbox-time">{{item.createTime}}</text></view>
        <text class="inbox-content">{{item.type==='greeting'?'点击查看欢迎词':item.content}}</text>
      </view>
    </block>
    <view class="empty-state" wx:if="{{myListDisplay.length===0}}">暂无通知</view>
  </view>

  <view class="back-area"><view class="btn-back" bindtap="onBack"><text class="btn-back-icon">←</text><text class="btn-back-text">返回上级</text></view></view>
</view>

<view class="modal-mask" wx:if="{{showForm}}" bindtap="hideForm"></view>
<view class="form-modal" wx:if="{{showForm}}">
  <view class="modal-header"><text class="modal-title">{{formTitle}}</text><text class="modal-close" bindtap="hideForm">✕</text></view>
  <view class="modal-body">
    <view class="input-group"><text class="input-label">标题</text><input class="input-field" value="{{form.title}}" bindinput="onInputChange" data-field="title" placeholder="请输入通知标题"/></view>
    <view class="input-group"><text class="input-label">内容</text><textarea class="textarea-field" value="{{form.content}}" bindinput="onInputChange" data-field="content" placeholder="请输入通知内容" auto-height maxlength="-1"/></view>
    <view class="input-group"><text class="input-label">发布范围</text>
      <picker mode="selector" range="{{roleOptions}}" bindchange="onRoleChange"><view class="picker-field">{{roleOptions[form.targetRole==='all'?0:form.targetRole==='visitor'?1:form.targetRole==='host'?2:form.targetRole==='admin'?3:4]}}</view></picker>
    </view>
  </view>
  <view class="modal-footer"><button class="btn-cancel" bindtap="hideForm">取消</button><button class="btn-primary" bindtap="onSave">保存</button></view>
</view>

<view class="modal-mask" wx:if="{{showDetail}}" bindtap="hideDetail"></view>
<view class="detail-modal" wx:if="{{showDetail}}">
  <view class="modal-header"><text class="modal-title">通知详情</text><text class="modal-close" bindtap="hideDetail">✕</text></view>
  <view class="modal-body"><text class="detail-title-text">{{detailItem.title}}</text><text class="detail-time">{{detailItem.createTime}}</text><view class="detail-divider"></view><text class="detail-content">{{detailItem.content}}</text></view>
  <view class="modal-footer"><button class="btn-primary" bindtap="hideDetail" style="flex:1;">关闭</button></view>
</view>

<view class="modal-mask" wx:if="{{showRecipients}}" bindtap="hideRecipients"></view>
<view class="detail-modal" wx:if="{{showRecipients}}">
  <view class="modal-header"><text class="modal-title">通知接收详情</text><text class="modal-close" bindtap="hideRecipients">✕</text></view>
  <view class="modal-body"><view class="recipient-list">
    <block wx:for="{{recipients}}" wx:key="id"><view class="recipient-item"><text class="recipient-user">用户ID：{{item.userId}}</text><text class="recipient-status">状态：{{item.isRead===1?'已读':'未读'}}</text><text class="recipient-time">{{item.createTime}}</text></view></block>
    <view wx:if="{{recipients.length===0}}" class="empty-tip">暂无接收记录</view>
  </view></view>
  <view class="modal-footer"><button class="btn-primary" bindtap="hideRecipients" style="flex:1;">关闭</button></view>
</view>

<tabBar activeTab="2"></tabBar>
