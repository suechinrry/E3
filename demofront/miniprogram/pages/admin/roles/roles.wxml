<view class="page">
  <block wx:for="{{roles}}" wx:key="id" wx:for-item="role">
    <view class="role-card">
      <view class="role-header" bindtap="toggleExpand" data-id="{{role.id}}">
        <view class="role-left">
          <view class="role-icon" style="background: {{role.color}};">
            <text>{{role.icon}}</text>
          </view>
          <view class="role-info">
            <text class="role-name">{{role.name}}</text>
            <text class="role-desc">{{role.desc}}</text>
          </view>
        </view>
        <text class="expand-arrow">{{expandedId === role.id ? '▲' : '▼'}}</text>
      </view>

      <!-- 展开后显示权限范围 -->
      <view class="perm-panel" wx:if="{{expandedId === role.id}}">
        <block wx:for="{{role.routes}}" wx:key="label" wx:for-item="item">
          <view class="route-item">
            <text class="route-icon">{{item.icon}}</text>
            <text class="route-label">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
