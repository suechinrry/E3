<scroll-view scroll-y="true" style="height: 100vh; padding-bottom: 140rpx;" enhanced="true" show-scrollbar="{{false}}">
  <view class="stats-overview">
    <view class="stat-item">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">总来访</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.thisMonth}}</text>
      <text class="stat-label">本月</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{stats.companies}}</text>
      <text class="stat-label">来访单位</text>
    </view>
  </view>

  <view class="card" style="margin-top: 0;">
    <view class="menu-item" bindtap="goHelper">
      <text class="menu-text">➕ 辅助预约（代访客预约）</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">近期被访记录</view>
    <block wx:for="{{list}}" wx:key="id">
      <view class="list-item">
        <view>
          <text class="record-name">{{item.visitorName}}</text>
          <text class="record-company"> | {{item.company}}</text>
          <view class="record-meta">{{item.purpose}} · {{item.startTime}}</view>
        </view>
        <text class="tag tag-{{item.status}}">{{statusMap[item.status]}}</text>
      </view>

      <view class="greeting-box" wx:if="{{item.greetingText && item.status === 'approved'}}">
        <view class="greeting-header">
          <text class="greeting-title">🤖 接待建议</text>
          <text class="greeting-source {{item.greetingSource === 'ai' ? 'ai' : 'mock'}}">{{item.greetingSource === 'ai' ? 'AI生成' : '模板生成'}}</text>
        </view>
        <view class="greeting-body">
          <view class="greeting-line">
            <text class="greeting-label">欢迎语</text>
            <text class="greeting-value">{{item.greetingText}}</text>
          </view>
          <view class="greeting-line" wx:if="{{item.seatSuggestion}}">
            <text class="greeting-label">座位建议</text>
            <text class="greeting-value">{{item.seatSuggestion}}</text>
          </view>
          <view class="greeting-line" wx:if="{{item.notes}}">
            <text class="greeting-label">注意事项</text>
            <text class="greeting-value">{{item.notes}}</text>
          </view>
        </view>
        <view class="greeting-footer" bindtap="onRegenerate" data-id="{{item.id}}">
          <text class="regenerate-link">🔄 重新生成</text>
        </view>
      </view>
    </block>
  </view>
</scroll-view>
<tabBar activeTab="0"></tabBar>
