.page { padding-bottom: 40rpx; }

.tabs {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
  align-items: center;
}
.tab {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab.active {
  color: #1a7cee;
  font-weight: 500;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 30rpx;
  height: 4rpx;
  background: #1a7cee;
  border-radius: 2rpx;
}
.mark-all-btn {
  font-size: 24rpx;
  color: #1a7cee;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: #f0f6ff;
  margin-left: auto;
  white-space: nowrap;
}

.notification-card {
  padding: 24rpx 30rpx;
}
.notification-card.is-read {
  opacity: 0.6;
}

.notification-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.notification-type-icon {
  font-size: 32rpx;
}

.notification-title {
  font-size: 30rpx;
  font-weight: 500;
  flex: 1;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #ff4d4f;
}

.notification-time {
  font-size: 22rpx;
  color: #bbb;
}

.notification-summary {
  font-size: 26rpx;
  color: #888;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
